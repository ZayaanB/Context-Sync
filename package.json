{
  "name": "context-sync",
  "displayName": "ContextSync",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "description": "Collaborative AI context sharing for VS Code teams via Obsidian and OneDrive",
  "version": "1.3.2",
  "publisher": "ZayaanBhanwadia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZayaanB/Context-Sync"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Machine Learning",
    "Programming Languages"
  ],
  "keywords": [
    "ai",
    "copilot",
    "gpt",
    "llm",
    "chatgpt",
    "productivity",
    "context",
    "context sharing",
    "team collaboration",
    "memory",
    "obsidian",
    "sync"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "contextSync.openChat",
        "title": "ContextSync: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "contextSync.syncNow",
        "title": "ContextSync: Sync Now",
        "icon": "$(sync)"
      },
      {
        "command": "contextSync.setAnthropicKey",
        "title": "ContextSync: Set Anthropic API Key"
      },
      {
        "command": "contextSync.setOpenAiKey",
        "title": "ContextSync: Set OpenAI API Key"
      },
      {
        "command": "contextSync.recoverPending",
        "title": "ContextSync: Recover Pending Exports"
      }
    ],
    "chatParticipants": [
      {
        "id": "contextsync.assistant",
        "name": "contextsync",
        "fullName": "ContextSync",
        "description": "Query your team's shared context graph",
        "isSticky": true
      }
    ],
    "configuration": {
      "title": "ContextSync",
      "properties": {
        "contextSync.syncFolder": {
          "type": "string",
          "description": "Absolute path to your OneDrive/Obsidian vault folder",
          "default": ""
        },
        "contextSync.username": {
          "type": "string",
          "description": "Your display name (used for file naming, e.g. 'alice')",
          "default": ""
        },
        "contextSync.maxContextFiles": {
          "type": "number",
          "description": "Max number of .md context files to inject per chat request",
          "default": 5,
          "minimum": 1
        },
        "contextSync.retrievalMode": {
          "type": "string",
          "enum": ["lexical", "hybrid"],
          "default": "lexical",
          "description": "Rank by keyword overlap, or add supporting notes found by weighted Dijkstra traversal of wikilinks."
        },
        "contextSync.maxContextBytes": {
          "type": "integer",
          "default": 4096,
          "minimum": 512,
          "maximum": 65536,
          "description": "Maximum UTF-8 bytes in the shared context block. This is a byte limit; model token limits are checked separately."
        },
        "contextSync.maxGraphDistance": {
          "type": "number",
          "default": 4,
          "minimum": 0,
          "maximum": 10,
          "description": "Maximum cumulative graph cost in hybrid mode. Link costs range from 1 to 2; zero disables expansion."
        },
        "contextSync.maxGraphNodes": {
          "type": "integer",
          "default": 200,
          "minimum": 1,
          "maximum": 1000,
          "description": "Maximum settled nodes per graph search in hybrid mode. Edge scans are also bounded."
        },
        "contextSync.anthropicModels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Anthropic model IDs offered in the model picker once an API key is stored (ContextSync: Set Anthropic API Key)",
          "default": [
            "claude-sonnet-4-5",
            "claude-haiku-4-5"
          ]
        },
        "contextSync.openaiModels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "OpenAI model IDs offered in the model picker once an API key is stored (ContextSync: Set OpenAI API Key)",
          "default": [
            "gpt-4o",
            "gpt-4o-mini"
          ]
        },
        "contextSync.maxInputTokens": {
          "type": "integer",
          "default": 12000,
          "minimum": 1024,
          "description": "Conservative input budget for direct API models. Lower this for models with smaller context windows."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node scripts/test.cjs",
    "benchmark:retrieval": "npm run compile && node scripts/benchmark-retrieval.cjs",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/vscode": "1.90.0",
    "typescript": "^6.0.3"
  },
  "extensionKind": [
    "ui"
  ]
}
